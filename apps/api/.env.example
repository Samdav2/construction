# =================================================================
# Cpro Hub / BuildHub API - Railway Environment Variables Template
# =================================================================

# Server & Runtime
PORT=5000
NODE_ENV=production

# Frontend URLs (for CORS and redirects)
# Set to your Railway Web Service URL: e.g. https://cprohub-web.up.railway.app
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Database Connection
# Use Railway MongoDB Plugin URI: e.g. ${{MongoDB.MONGO_URL}}
# Or external MongoDB Atlas connection string:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/buildhub?retryWrites=true&w=majority

# Security (JWT secret must be at least 16 characters)
JWT_SECRET=replace_this_with_a_super_strong_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Email Service (Nodemailer SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-smtp-app-password
EMAIL_FROM="Cpro Hub" <noreply@cprohub.com>
EMAIL_SECURE=false

# Media & Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI & Scraper Integrations (Optional / Feature specific)
GEMINI_API_KEY=your_google_gemini_api_key
JSEARCH_API_KEY=your_rapidapi_jsearch_key

# Payment Gateway (Swychr)
SWYCHR_EMAIL=your_swychr_merchant_email
SWYCHR_PASSWORD=your_swychr_merchant_password
SWYCHR_WEBHOOK_SECRET=your_swychr_webhook_secret
SWYCHR_ALLOW_INSECURE_TLS=false

