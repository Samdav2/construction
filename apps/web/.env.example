# =================================================================
# Cpro Hub / BuildHub Web - Railway Environment Variables Template
# =================================================================

# URL to your deployed Railway API service (include /api/v1 suffix)
# Example: https://cprohub-api.up.railway.app/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# Real-time WebSocket server root URL (without trailing slash or path)
# Example: https://cprohub-api.up.railway.app
VITE_SOCKET_URL=http://localhost:5000
